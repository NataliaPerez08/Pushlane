# OJO: Technitium solo lee estas variables en el PRIMER arranque (volumen
# dns_config vacio); cambiarlas despues no tiene efecto. Para reinicializar
# la configuracion hay que borrar el volumen dns_config.
# El rol dns escribe el .env real desde el vault; este archivo es referencia.
# El 53 se publica solo en esta IP (evita el conflicto con el stub de
# systemd-resolved en 127.0.0.53); el rol dns la toma del inventario.
DNS_BIND_IP=192.168.10.21
DNS_SERVER_DOMAIN=dns.lab.local
DNS_SERVER_ADMIN_PASSWORD=<contrasena-de-admin>
DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
