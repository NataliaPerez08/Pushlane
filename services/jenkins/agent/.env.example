# Copia este archivo como .env cuando crees el agente inbound en Jenkins.
# El secret se genera al guardar el nodo y se copia aqui (o via Ansible
# con jenkins_agent_secret en el inventario o vault; nunca se versiona).
JENKINS_SECRET=<secret-del-agente>
JENKINS_URL=http://pushlane-ci.lab.local:8080
JENKINS_AGENT_NAME=pushlane-agent