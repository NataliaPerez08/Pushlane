def PREV_IMAGE = ''

def healthCheck() {
    retry(5) {
        sleep 3
        sh 'curl --fail --silent http://pushlane-app.lab.local:8000/health'
    }
}

pipeline {
    agent { label 'docker' }

    environment {
        REGISTRY = 'pushlane-app.lab.local:5000'
        IMAGE = "${REGISTRY}/demo-api:${GIT_COMMIT}"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Lint and Test') {
            steps {
                dir('apps/demo-api') {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r requirements-dev.txt
                        .venv/bin/ruff check app tests
                        PYTHONPATH=. .venv/bin/pytest -q --junitxml=results/pytest.xml
                    '''
                }
            }
        }

        stage('Dependency Scan') {
            steps {
                dir('apps/demo-api') {
                    sh '''
                        .venv/bin/pip install -q pip-audit
                        .venv/bin/pip-audit -r requirements.txt
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t "$IMAGE" apps/demo-api'
            }
        }

        stage('Image Scan') {
            steps {
                sh '''
                    mkdir -p results
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:0.57.1 image --quiet --ignore-unfixed --scanners vuln \
                        --severity CRITICAL --exit-code 1 --format json \
                        "$IMAGE" > results/trivy.json
                '''
            }
        }

        stage('Publish') {
            when { branch 'main' }
            steps { sh 'docker push "$IMAGE"' }
        }

        stage('Deploy DEV') {
            when { branch 'main' }
            steps {
                sshagent(credentials: ['pushlane-app-ssh']) {
                    script {
                        PREV_IMAGE = sh(
                            script: '''
                                ssh -o StrictHostKeyChecking=yes devops@pushlane-app.lab.local \
                                  'cd /opt/pushlane/app && CID=$(docker compose ps -q demo-api) && if [ -n "$CID" ]; then IMG=$(docker inspect --format "{{.Config.Image}}" "$CID"); else IMG=none; fi && echo "$IMG"'
                            ''',
                            returnStdout: true
                        ).trim()
                    }
                    sh '''
                        ssh -o StrictHostKeyChecking=yes devops@pushlane-app.lab.local \
                          "cd /opt/pushlane/app && APP_IMAGE=$IMAGE docker compose up -d demo-api"
                    '''
                }
            }
        }

        stage('Health Check') {
            when { branch 'main' }
            steps { healthCheck() }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'results/pytest.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'results/*'
            deleteDir()
        }
        failure {
            script {
                if (PREV_IMAGE && PREV_IMAGE != 'none') {
                    echo "Health check failed, rolling back to ${PREV_IMAGE}"
                    sshagent(credentials: ['pushlane-app-ssh']) {
                        sh "ssh -o StrictHostKeyChecking=yes devops@pushlane-app.lab.local \"cd /opt/pushlane/app && APP_IMAGE=${PREV_IMAGE} docker compose up -d demo-api\""
                    }
                    echo 'Rollback deployed, re-checking health'
                    try {
                        healthCheck()
                        currentBuild.result = 'UNSTABLE'
                        echo 'Recovered after rollback'
                    } catch (err) {
                        echo "Rollback also unhealthy: ${err}"
                    }
                } else if (PREV_IMAGE) {
                    echo 'No previous image to roll back to (first deploy)'
                }
            }
        }
    }
}